# Stripe API Keys (Dashboard -> https://dashboard.stripe.com/test/apikeys)
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Webhook Secret (Dashboard -> https://dashboard.stripe.com/workbench/webhooks)
# Required: /api/webhook rejects events it can't verify.
STRIPE_WEBHOOK_SECRET=whsec_...

# Application Domain URL (optional on Vercel: detected from the request)
DOMAIN=http://localhost:3000

# Stripe Price ID for the generic OnlyAgents membership sold on /checkout
# (Dashboard -> https://dashboard.stripe.com/prices). Individual agents are
# priced from agents.js so checkout always matches the marketplace cards.
STRIPE_PRICE_ID=price_...
